<% content_for :title, "Sign in" %>

<main class="page">
  <header>
    <h1>Sign in</h1>
    <p class="muted">The forms page is for the site owner. Sign in with Google.</p>
  </header>

  <% if @error %><p class="error" role="alert"><%= @error %></p><% end %>

  <%= button_to "Sign in with Google", "/auth/google_oauth2", method: :post, data: { turbo: false }, class: "button" %>
</main>
