<% content_for :title, "Traffic" %>

<main class="page">
  <header>
    <h1>Traffic</h1>
    <p class="muted">Requests each site served, from the server's proxy log (counts only: no IPs or user agents). Health
      checks and this platform's own monitor are left out. Portfolio isn't on the server; its traffic is in Vercel Analytics.</p>
  </header>

  <% @sites.each do |entry| %>
    <% site, day, month = entry[:site], entry[:day], entry[:month] %>
    <section class="site" id="<%= site.slug %>">
      <div class="site-head"><h2><%= site.name %></h2></div>

      <% if entry[:last_at].nil? %>
        <% if site.traffic %>
          <p class="muted">Not on the server: see <%= link_to "its analytics", site.traffic, rel: "noopener" %>.</p>
        <% else %>
          <p class="muted">No traffic recorded yet.</p>
        <% end %>
      <% else %>
        <dl class="facts">
          <div><dt>Requests (24h)</dt><dd><%= number_with_delimiter(day[:requests]) %></dd></div>
          <div><dt>Errors 5xx / 4xx</dt><dd><%= day[:errors_5xx] %> / <%= day[:errors_4xx] %></dd></div>
          <div><dt>Avg / max</dt><dd><%= day[:avg_ms] ? "#{day[:avg_ms]} / #{day[:max_ms]} ms" : "—" %></dd></div>
          <div><dt>Requests (30 days)</dt><dd><%= number_with_delimiter(month[:requests]) %></dd></div>
        </dl>

        <% [ [ "Last 24 hours, per hour", entry[:hourly], "%b %-d %H:00 UTC" ], [ "Last 30 days, per day", entry[:daily], "%b %-d" ] ].each do |label, series, format| %>
          <% peak = [ series.map(&:last).max, 1 ].max %>
          <p class="chart-label"><%= label %> (peak <%= number_with_delimiter(peak) %>)</p>
          <div class="bars" role="img" aria-label="<%= label %>">
            <% series.each do |at, count| %>
              <span class="bar" style="height: <%= (count * 100.0 / peak).round(1) %>%" title="<%= at.strftime(format) %>: <%= number_with_delimiter(count) %> requests"></span>
            <% end %>
          </div>
        <% end %>
        <p class="muted small">Last data: <%= time_ago_in_words(entry[:last_at]) %> ago.</p>
      <% end %>
    </section>
  <% end %>
</main>
