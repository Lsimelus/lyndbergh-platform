#!/usr/bin/env python3
"""Send per-minute traffic totals from kamal-proxy's request log to lyndbergh-platform (POST /api/traffic).

Runs on the server from cron every 5 minutes (see README, Traffic). Reads only the log lines newer than the last
run, adds them up per host and minute (requests, 4xx, 5xx, total and max response time) and posts the totals.
Nothing else leaves the server: no IPs, user agents, paths or query strings.

Config (/etc/traffic-collector.env, root only):  TRAFFIC_URL=https://platform.lyndbergh.net/api/traffic
                                                  TRAFFIC_TOKEN=<same as the platform's TRAFFIC_TOKEN>
State: /var/lib/traffic-collector/last (the newest log timestamp already sent).

    traffic-collector                 normal run
    traffic-collector --dry-run       print the totals instead of posting (reads `docker logs` as usual)
    traffic-collector --stdin --dry-run < sample.log    totals for log lines on stdin (testing)
"""
import json
import os
import subprocess
import sys
import urllib.request
from collections import defaultdict
from datetime import datetime, timedelta, timezone

STATE = os.environ.get("TRAFFIC_STATE", "/var/lib/traffic-collector/last")
ENV_FILE = "/etc/traffic-collector.env"
# Health checks and the platform's own monitor aren't traffic.
SKIP_PATHS = {"/up", "/health", "/api/health", "/api/heartbeat"}
SKIP_AGENTS = ("lyndbergh-platform-monitor", "kamal-proxy")


def parse_time(value):
    """RFC 3339 with nanoseconds ('2026-11-20T01:46:35.780282057Z') -> aware datetime."""
    value = value.rstrip("Z")
    if "." in value:
        whole, frac = value.split(".", 1)
        value = f"{whole}.{frac[:6]}"
    return datetime.fromisoformat(value).replace(tzinfo=timezone.utc)


def totals(lines, after=None):
    """Per (host, minute) totals of kamal-proxy `Request` lines newer than `after`; returns (rows, newest time)."""
    buckets = defaultdict(lambda: {"requests": 0, "errors_4xx": 0, "errors_5xx": 0, "total_ms": 0.0, "max_ms": 0.0})
    newest = after
    for line in lines:
        try:
            entry = json.loads(line)
        except ValueError:
            continue
        if entry.get("msg") != "Request" or "time" not in entry or "host" not in entry:
            continue
        at = parse_time(entry["time"])
        if after and at <= after:
            continue
        newest = max(newest, at) if newest else at
        agent = str(entry.get("req_user_agent") or entry.get("user_agent") or "")
        if entry.get("path") in SKIP_PATHS or agent.startswith(SKIP_AGENTS):
            continue
        status = int(entry.get("status") or 0)
        ms = int(entry.get("duration") or 0) / 1_000_000  # kamal-proxy logs nanoseconds
        b = buckets[(entry["host"], at.replace(second=0, microsecond=0))]
        b["requests"] += 1
        b["errors_4xx"] += 400 <= status < 500
        b["errors_5xx"] += status >= 500
        b["total_ms"] += ms
        b["max_ms"] = max(b["max_ms"], ms)
    rows = [{"host": host, "minute": minute.strftime("%Y-%m-%dT%H:%M:00Z"), **b, "total_ms": round(b["total_ms"], 1),
             "max_ms": round(b["max_ms"], 1)} for (host, minute), b in sorted(buckets.items())]
    return rows, newest


def load_env():
    if os.path.exists(ENV_FILE):
        with open(ENV_FILE) as f:
            for line in f:
                key, sep, value = line.strip().partition("=")
                if sep and not key.startswith("#"):
                    os.environ.setdefault(key, value)


def read_state():
    try:
        with open(STATE) as f:
            return parse_time(f.read().strip())
    except (OSError, ValueError):
        return None


def write_state(at):
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    with open(STATE + ".tmp", "w") as f:
        f.write(at.strftime("%Y-%m-%dT%H:%M:%S.%fZ"))
    os.replace(STATE + ".tmp", STATE)


def post(rows):
    request = urllib.request.Request(
        os.environ["TRAFFIC_URL"], method="POST", data=json.dumps({"rows": rows}).encode(),
        headers={"Content-Type": "application/json", "Authorization": f"Bearer {os.environ['TRAFFIC_TOKEN']}",
                 "User-Agent": "traffic-collector"})
    with urllib.request.urlopen(request, timeout=20) as response:
        return response.status


def main(argv):
    dry_run = "--dry-run" in argv
    if "--stdin" in argv:
        rows, _ = totals(sys.stdin)
        print(json.dumps(rows, indent=1))
        return 0

    load_env()
    after = read_state() or datetime.now(timezone.utc) - timedelta(minutes=10)
    since = (after - timedelta(seconds=1)).strftime("%Y-%m-%dT%H:%M:%SZ")  # lines at `after` itself are skipped below
    log = subprocess.run(["docker", "logs", "--since", since, "kamal-proxy"], capture_output=True, text=True, check=True)
    rows, newest = totals((log.stdout + log.stderr).splitlines(), after=after)
    if dry_run:
        print(json.dumps(rows, indent=1))
        return 0
    if rows:
        post(rows)
    if newest and newest != after:
        write_state(newest)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
